#!/usr/bin/env -S deno run --allow-run --allow-read --allow-env

const args = Deno.args;
const command = args[0];

async function run(program, programArgs) {
  const child = new Deno.Command(program, {
    args: programArgs,
    stdin: "inherit",
    stdout: "inherit",
    stderr: "inherit",
  });
  const status = await child.output();
  Deno.exit(status.code);
}

if (command === "install" || command === "i" || command === "ci") {
  console.log("[dhblink npm shim] running deno install");
  await run("deno", ["install"]);
}

if (command === "run" && args[1] === "build") {
  console.log("[dhblink npm shim] running deno task build");
  await run("deno", ["task", "build"]);
}

console.error(`[dhblink npm shim] unsupported npm command: ${args.join(" ")}`);
Deno.exit(1);
